---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="ko">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="그레이스기독학교 - Coram Deo" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
        <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&display=swap" rel="stylesheet">
	</head>
	<body class="font-sans antialiased text-gray-900 bg-white">
        <!-- Header -->
        <header class="bg-white shadow-sm sticky top-0 z-50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex justify-between h-16 items-center">
                    <div class="flex-shrink-0 flex items-center">
                        <a href="/" class="text-2xl font-bold text-primary">Grace Christian School</a>
                    </div>
                    <nav class="hidden md:flex space-x-8">
                        <a href="/" class="text-gray-700 hover:text-primary px-3 py-2 font-medium">Home</a>
                        <a href="/about" class="text-gray-700 hover:text-primary px-3 py-2 font-medium">학교소개</a>
                        <a href="/admission" class="text-gray-700 hover:text-primary px-3 py-2 font-medium">입학안내</a>
                        <a href="/news" class="text-gray-700 hover:text-primary px-3 py-2 font-medium">학교소식</a>
                        <a href="/gallery" class="text-gray-700 hover:text-primary px-3 py-2 font-medium">갤러리</a>
                        <a href="/contact" class="text-gray-700 hover:text-primary px-3 py-2 font-medium">문의하기</a>
                    </nav>
                </div>
            </div>
        </header>

		<slot />

        <!-- Footer -->
        <footer class="bg-gray-800 text-white py-12">
            <div class="max-w-7xl mx-auto px-4 grid grid-cols-1 md:grid-cols-3 gap-8">
                <div>
                    <h3 class="text-xl font-bold mb-4">그레이스기독학교</h3>
                    <p class="text-gray-400">경기도 안양시 동안구 동안로 70</p>
                    <p class="text-gray-400">070-7430-2777</p>
                </div>
                <div>
                    <h3 class="text-xl font-bold mb-4">바로가기</h3>
                    <ul class="space-y-2">
                        <li><a href="/about" class="text-gray-400 hover:text-white">학교소개</a></li>
                        <li><a href="/admission" class="text-gray-400 hover:text-white">입학안내</a></li>
                    </ul>
                </div>
                <div>
                    <p class="text-gray-500 text-sm">© 2026 Grace Christian School. All rights reserved.</p>
                </div>
            </div>
        </footer>
        
        <script>
          if (window.netlifyIdentity) {
            window.netlifyIdentity.on("init", user => {
              if (!user) {
                window.netlifyIdentity.on("login", () => {
                  document.location.href = "/admin/";
                });
              }
            });
          }
        </script>
	</body>
</html>
