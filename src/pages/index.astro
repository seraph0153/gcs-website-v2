---
import Layout from '../layouts/Layout.astro';
import mainLayout from '../content/config/main_layout.json';
---

<Layout title="그레이스기독학교 - Home">
	<main>
        <!-- Hero Section -->
        <section class="relative h-[600px] flex items-center justify-center text-center text-white bg-gray-900">
            <div class="absolute inset-0 overflow-hidden">
                <!-- Fallback gradient if no image -->
                <div class="absolute inset-0 bg-gradient-to-r from-blue-900 to-gray-900 opacity-90"></div>
                {mainLayout.hero_image && <img src={mainLayout.hero_image} class="w-full h-full object-cover opacity-50" />}
            </div>
            
            <div class="relative z-10 max-w-3xl mx-auto px-4">
                <h1 class="text-5xl md:text-6xl font-bold mb-6 tracking-tight">
                    {mainLayout.hero_title}
                </h1>
                <p class="text-xl md:text-2xl mb-10 text-gray-200 font-light">
                    {mainLayout.hero_subtitle}
                </p>
                <div class="flex justify-center gap-4">
                    <a href={mainLayout.hero_button_link} class="px-8 py-3 bg-secondary hover:bg-orange-600 text-white font-bold rounded-full transition duration-300 transform hover:scale-105 shadow-lg">
                        {mainLayout.hero_button_text}
                    </a>
                </div>
            </div>
        </section>

        <!-- Features Section (Static for now, can be dynamic later) -->
        <section class="py-20 bg-white">
            <div class="max-w-7xl mx-auto px-4">
                <div class="text-center mb-16">
                    <span class="text-primary font-bold tracking-wider uppercase text-sm">Why GCS?</span>
                    <h2 class="text-3xl font-bold mt-2">그레이스기독학교의 특징</h2>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
                    {[
                        {icon: "📖", title: "성경적 교육", desc: "절대 진리인 성경을 교육의 기초로 삼습니다."},
                        {icon: "🏫", title: "정식 인가", desc: "경기도교육청 등록 대안교육기관입니다."},
                        {icon: "❤️", title: "전인 교육", desc: "영성, 인성, 지성의 균형 잡힌 발달."},
                        {icon: "🤝", title: "사랑의 공동체", desc: "서로 사랑하고 섬기는 학교 문화."}
                    ].map(feature => (
                        <div class="p-6 bg-gray-50 rounded-xl hover:shadow-xl transition duration-300 text-center group">
                            <div class="text-4xl mb-4 group-hover:scale-110 transition duration-300 inline-block">{feature.icon}</div>
                            <h3 class="text-xl font-bold mb-2 text-gray-800">{feature.title}</h3>
                            <p class="text-gray-600">{feature.desc}</p>
                        </div>
                    ))}
                </div>
            </div>
        </section>
	</main>
</Layout>
