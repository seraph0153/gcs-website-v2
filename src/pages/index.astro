---
import Layout from '../layouts/Layout.astro';
import mainLayout from '../content/config/main_layout.json';
import HeroBlock from '../components/blocks/HeroBlock.astro';
import FeaturesBlock from '../components/blocks/FeaturesBlock.astro';
import ContentBlock from '../components/blocks/ContentBlock.astro';
import NewsBlock from '../components/blocks/NewsBlock.astro';
---

<Layout title="그레이스기독학교 - Home">
	<main>
        {mainLayout.sections?.map((block: any) => {
            switch (block.type) {
                case 'hero':
                    return <HeroBlock {...block} />;
                case 'features':
                    return <FeaturesBlock {...block} />;
                case 'content':
                    return <ContentBlock {...block} />;
                case 'news':
                    return <NewsBlock {...block} />;
                default:
                    return null;
            }
        })}
	</main>
</Layout>
