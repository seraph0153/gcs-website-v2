---
import { marked } from 'marked';

interface Props {
  title?: string;
  body: string;
  image?: string;
  image_pos?: "left" | "right";
  bg_color?: "white" | "gray";
}

const { title, body, image, image_pos = "right", bg_color = "white" } = Astro.props;

const contentHtml = marked.parse(body || "");
const bgClass = bg_color === "gray" ? "bg-gray-100" : "bg-white";
---

<section class={`py-20 ${bgClass}`}>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class={`flex flex-col md:flex-row gap-12 items-center ${image_pos === 'left' ? 'md:flex-row-reverse' : ''}`}>
            
            <!-- Text Content -->
            <div class={`flex-1 ${!image ? 'text-center max-w-4xl mx-auto' : ''}`}>
                {title && (
                    <h2 class="text-3xl font-bold mb-6 text-gray-900">{title}</h2>
                )}
                <div class="prose prose-lg text-gray-600 max-w-none" set:html={contentHtml} />
            </div>

            <!-- Image (Optional) -->
            {image && (
                <div class="flex-1 w-full">
                    <img 
                        src={image} 
                        alt="Section Image" 
                        class="rounded-xl shadow-lg w-full h-[400px] object-cover hover:shadow-2xl transition duration-500"
                    />
                </div>
            )}
        </div>
    </div>
</section>
